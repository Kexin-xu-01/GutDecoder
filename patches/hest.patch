-        _alignment_plot_to_file(cpu_boxes, 
-                                template, 
-                                edge_len, 
-                                aligned_spots, 
-                                factor,
-                                aligned_fiducials,
-                                img,
-                                save_path)
-
-
-        _spots_to_file(os.path.join(save_dir, name + 'autoalignment.json'), dict)

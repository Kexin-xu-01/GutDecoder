-    while i < len(df):
-        start = i
-        j = i + l
-        while j < len(df):
-            if arr[j] != arr[j - 1]:
-                break
-            j += 1
-        end = min(len(df), j)
-        coords.append((start, end))
-        i = j
-    
-    chunks = []
-    for start, end in coords:
-        chunks.append(df[start:end])
-    return chunks
